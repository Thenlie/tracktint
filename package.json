{
  "name": "fit-map-viewer",
  "version": "1.0.0",
  "description": "Visualize GPS tracks from FIT files on an interactive map",
  "scripts": {
    "start": "tsc --noEmit && tsx --tsconfig tsconfig.json src/index.ts",
    "build": "tsc",
    "run:dist": "node dist/index.js",
    "fetch-names": "tsc --noEmit && tsx --tsconfig tsconfig.json src/fetch-names.ts"
  },
  "dependencies": {
    "fit-file-parser": "^1.9.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
